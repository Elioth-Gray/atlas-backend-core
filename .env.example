# Copy to .env first (cp .env.example .env); compose.dev.yaml, compose.prod.yaml and
# `go run ./cmd/api` all read it. Real environment variables override values here.
# Never commit .env: it holds secrets (database password, gRPC token).

# --- PostgreSQL container (both compose files) --------------------------------------
# For compose.prod.yaml use a long random password with URL-safe characters only,
# because the compose files put it into DATABASE_URL.
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas

# --- App ---------------------------------------------------------------------------
APP_NAME=atlas-backend-core
# development | staging | production | test (the compose files set this themselves)
APP_ENV=development

# --- HTTP server (REST for the frontend) ------------------------------------------
HTTP_HOST=
# Port for `go run ./cmd/api`, same as the dev container's published port. Inside Docker
# the API always listens on 8080 (published as 3333 in dev, 8000 in prod).
HTTP_PORT=3333
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
# Maximum request body size in bytes (1 MiB).
HTTP_MAX_BODY_BYTES=1048576
# Comma-separated IPs/CIDRs of reverse proxies allowed to set X-Forwarded-For.
# Empty = trust none (client IP is the TCP peer address).
HTTP_TRUSTED_PROXIES=

# --- gRPC server (other backends) ------------------------------------------------------
GRPC_ENABLED=true
GRPC_HOST=
# Inside Docker gRPC always listens on 9090 (published as 9090 in dev, 9000 in prod).
GRPC_PORT=9090
# Shared secret other backends send as "authorization: Bearer <token>".
# Empty disables auth in development. compose.prod.yaml refuses to start without one
# (at least 32 characters, e.g. `openssl rand -hex 32`).
GRPC_AUTH_TOKEN=
# Optional TLS. Set both or neither.
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
# 4 MiB
GRPC_MAX_RECV_MSG_BYTES=4194304
GRPC_MAX_SEND_MSG_BYTES=4194304
GRPC_KEEPALIVE_TIME=2m
GRPC_KEEPALIVE_TIMEOUT=20s
GRPC_SHUTDOWN_TIMEOUT=15s

# --- CORS ------------------------------------------------------------------------------
# Comma-separated origins. Defaults match the frontend Docker setup: dev on 5173, prod on 8080.
# Empty disables CORS. "*" allows any origin (not allowed with CORS_ALLOW_CREDENTIALS=true).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=12h

# --- Database (PostgreSQL via GORM) -------------------------------------------------------
# Used by `go run` on the host (the dev database is published on 5433). The compose files
# build their own DATABASE_URL from the POSTGRES_* values above.
DATABASE_URL=postgres://atlas:atlas@localhost:5433/atlas?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=5s
# Queries slower than this are logged at warn level.
DB_SLOW_QUERY_THRESHOLD=200ms
# Log every SQL statement (bound parameters are never logged).
DB_LOG_QUERIES=false
# Apply pending migrations when the API starts (the compose files enable this).
DB_AUTO_MIGRATE=false

# --- Logging -------------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# json | text. Empty = json in staging/production, text otherwise.
LOG_FORMAT=
